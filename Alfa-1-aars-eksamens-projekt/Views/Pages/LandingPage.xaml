<Page x:Class="Alfa_1_aars_eksamens_projekt.Views.Pages.LandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Partials"
      xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Forside - Environmental Friendly">

    <!--Made by Natasha-->
    <Grid Background="White" Style="{DynamicResource RoundCornerMediumGreenGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="433*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <uc:NavBar x:Name="NavBarMenu" HorizontalAlignment="Left" Width="200" Visibility="Visible"/>

        <Button x:Name="btn_RegisterWasteElement" ToolTip="Registrer et affaldselement i databasen" Content="Registrer Affald" HorizontalAlignment="Left" Margin="246,95,0,0" VerticalAlignment="Top" Width="96" Height="30" Click="btn_RegisterWasteElement_Click"/>
        <Button x:Name="btn_ExportCSV" Style="{StaticResource RoundCornerTeal}" Content="Eksportér CSV af Eget Data" ToolTip="Eksporterer affaldselementer til en CSV fil i Dropzone mappen på C-drevet" HorizontalAlignment="Left" Margin="366,95,0,0" VerticalAlignment="Top" Width="166" Height="30" Click="btn_ExportCSV_Click"/>
        <Label Content="Affaldselementer" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" Margin="246,59,0,0" VerticalAlignment="Top" Height="25" Width="146"/>
        <DatePicker Text="Start Dato" x:Name="SortDateTimeStart" HorizontalAlignment="Left" 
            Margin="922,102,0,0" VerticalAlignment="Top" Height="23" FirstDayOfWeek="Monday" Width="142"
            BorderThickness="0" CalendarClosed="SortDateTimeStart_CalendarClosed">
            <DatePicker.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </DatePicker.Resources>
        </DatePicker>
        <DatePicker Text="Slut Dato" x:Name="SortDateTimeEnd" HorizontalAlignment="Left" 
            Margin="1081,102,0,0" VerticalAlignment="Top" Height="23" FirstDayOfWeek="Monday" Width="135"
            BorderThickness="0" CalendarClosed="SortDateTimeEnd_CalendarClosed" RenderTransformOrigin="0.738,0.812">
            <DatePicker.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </DatePicker.Resources>
        </DatePicker>
        

        <ListView x:Name="WasteElementListView" Margin="246,131,53,38">
            <ListView.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                    <Setter Property="BorderBrush" Value="#e9f6cb"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="#e9f6cb"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="25" DisplayMemberBinding="{Binding id}" />
                    <GridViewColumn Header="Affaldselement" DisplayMemberBinding="{Binding description}" />
                    <GridViewColumn Header="Mængde" DisplayMemberBinding="{Binding amount}" />
                    <GridViewColumn Header="Måleenhed" DisplayMemberBinding="{Binding measurementUnitName}" />
                    <GridViewColumn Header="Affaldskategori" DisplayMemberBinding="{Binding category}" />
                    <GridViewColumn Header="Ansvarlig" DisplayMemberBinding="{Binding responsibleEmployee}" />
                    <GridViewColumn Header="Dato" DisplayMemberBinding="{Binding dateTimePlainText}" />
                    <GridViewColumn Header="Rediger" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Name="EditWE" Style="{StaticResource RoundCornerTeal}" Click="EditWE_Click">Rediger</Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Slet" Width="80" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="DeleteWE" Content="Slet" Style="{StaticResource RoundCornerRed}" Click="DeleteWE_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
