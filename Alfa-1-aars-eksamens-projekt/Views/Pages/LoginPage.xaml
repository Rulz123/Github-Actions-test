<Page x:Class="Alfa_1_aars_eksamens_projekt.Views.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Pages"
      xmlns:uc="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Partials"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Login - Environmental Friendly">
    <!--Page made by Keemon-->

    <StackPanel Orientation="Vertical" Background="White" Style="{DynamicResource RoundCornerMediumGreen}">
        <Image Source="/Assets/Images/Elogo.png" Width="140" Panel.ZIndex="3" Margin="0,30,0,0" />
        <!--We create a label to tell the user what page we are on-->
        <Label Content="Login" Margin="0,10,0,0" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
        <!--We create a label to tell the user what to input in the textbox below-->
        <Label Content="Brugernavn" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,44,230,0"/>
        <!--We create a textbox for the user to input a username-->        
        <TextBox Name="username" Height="23" Width="300" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        <!--We create a label to tell the user to put in a password in the passwordbox below-->
        <Label Content="Kodeord" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,44,250,0"/>
        <!--We create a passwordbox for the user to input their password-->
        <PasswordBox Name="password" HorizontalAlignment="Center" BorderBrush="#A7D930" Background="#E9F6CB" BorderThickness="2" Height="23" VerticalAlignment="Top" Width="300"/>
        <!--We create a button that tells the user to login, and we bind it to the click event method in code behind-->
        <Button Name="Login" Margin="0,60,0,20" Content="Login" Height="30"  HorizontalAlignment="Center" VerticalAlignment="Top" Width="80" Click="Login_Click"/>
        <!--We create a textblock for a new user, in case the user haven't got a login, and we bind it with a hyperlink to display a popup window when clicked-->
        <TextBlock Name="CreateAccount" HorizontalAlignment="Center"><Hyperlink NavigateUri="RegisterCompanyProfile.xaml">Opret konto</Hyperlink></TextBlock>

    </StackPanel>
</Page>
