<Page x:Class="Alfa_1_aars_eksamens_projekt.Views.Pages.WasteInformation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Partials"
      xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="WasteInformation">
    <!--gamze-->
    <Grid Background="White">
        <uc:NavBar x:Name="NavBarMenu" HorizontalAlignment="Left" Height="720" Width="200" Visibility="Visible"/>
        <Label Content="Information om affaldssortering" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="521,82,0,0" VerticalAlignment="Top"/>
        <TabControl HorizontalAlignment="Left" Height="468" Margin="360,123,0,0" VerticalAlignment="Top" Width="613">
            <TabItem Header="Batterier" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Batterier sorteres som Batterier eller Farligt affald.
                        <LineBreak/><LineBreak/>
                        Herunder i disse kategorier på affaldsstationen tilhører:<LineBreak/>
                        - Sprøjtegift<LineBreak/>
                        - Lim<LineBreak/>
                        - Maling<LineBreak/>
                        - Olie<LineBreak/>
                        - Batterier
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - I pose på affaldsbeholder på egen adresse<LineBreak/>
                        - Container 36
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Biler" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Plastdele og inderskærme (plastik) fra personbiler sorteres som Småt brændbart

                        <LineBreak/><LineBreak/>
                        Herunder i disse kategorier på affaldsstationen tilhører:<LineBreak/>
                        - Flamingo<LineBreak/>
                        - Plastik<LineBreak/>
                        - Havemøbler<LineBreak/>
                        - Haveslanger<LineBreak/>
                        - Tagpap<LineBreak/>
                        - Troltexplader<LineBreak/>
                        - Havebassiner
                        <LineBreak/><LineBreak/>
                        
                        Afleveres typisk i:<LineBreak/>
                        - Container 20
                        <LineBreak/><LineBreak/>
                        
                        Dæk sorteres som Dæk

                        <LineBreak/><LineBreak/>
                        Herunder i denne kategori på affaldsstationen tilhører:<LineBreak/>
                        - Dæk
                        <LineBreak/><LineBreak/>
                        
                        Afleveres typisk i:<LineBreak/>
                        - Container 5
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Elektronikaffald" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Elektronik sorteres som Småt elektronik.
                        <LineBreak/><LineBreak/>
                        Herunder i denne kategori på affaldsstationen tilhører:<LineBreak/>
                        - Elektroniske genstande
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Container 33
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Imprægneret træ" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Imprægneret træ sorteres som Udendørs træ.
                        <LineBreak/><LineBreak/>
                        Herunder i denne kategori på affaldsstationen tilhører:<LineBreak/>
                        - Trykimprægneret træ<LineBreak/>
                        - Lygtepæle<LineBreak/>
                        - Sveller
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Container 21
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Inventar" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Inventar sorteres som Metal, Småtbrændbart, Stort brændbart og Indendørs træ
                        <LineBreak/><LineBreak/>
                        Herunder i disse kategorier på affaldsstationen tilhører:<LineBreak/>
                        - Møbler med stålrammer (metal)<LineBreak/>
                        - Campingmøbler med metalrammer (metal)<LineBreak/>
                        - Plasthavemøbler (småt brændbart)<LineBreak/>
                        - Møbler i træ (indendørs træ)<LineBreak/>
                        - Møbler u. stof (indendørs træ)<LineBreak/>
                        - Havemøbler i træ (indendørs træ)<LineBreak/>
                        - Polstrede møbler (stort brændbart)<LineBreak/>
                        - Bord - plasthavemøbel (stort brændbart)<LineBreak/>
                        - Mv.
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Container 18 Indendørs træ<LineBreak/>
                        - Container 19 Stort brændbart<LineBreak/>
                        - Container 20 Småt brændbart<LineBreak/>
                        - Container 9 Metal
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Organisk affald" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Organisk affald sorteres som Madaffald
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Madaffaldsspand på egen adresse<LineBreak/>
                        - Restaffald på egen adresse
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Pap og papir" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Papir sorteres som Papir, Pap sorteres som Pap
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Container 12 Pap<LineBreak/>
                        - Papaffaldsspand på egen adresse<LineBreak/>
                        - Container 13 Papir<LineBreak/>
                        - Papiraffaldsspand på egen adresse
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="Plastemballager" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Plastik sorteres som Hård plast og Blød plast
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Plastaffaldsspand på egen adresse Hård plast<LineBreak/>
                        - Restaffald Blød plast<LineBreak/>
                        - Container 15 Blød plast
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="PVC" Background="#A7D930" FontFamily="/Alfa-1-aars-eksamens-projekt;component/Resources/#PT Sans">
                <Grid Background="#e9f6cb">
                    <TextBlock>
                        Hård PVC sorteres som Hård PVC, Blød PVC sorteres som stort brændbart
                        <LineBreak/><LineBreak/>
                        Herunder i disse kategorier på affaldsstationen tilhører:<LineBreak/>
                        - Kloakrør (hård PVC)<LineBreak/>
                        - Drænrør (hård PVC)<LineBreak/>
                        - Elektrikerrør (hård PVC)<LineBreak/>
                        - Vandrør (hård PVC)<LineBreak/>
                        - Vandlåse (hård PVC)<LineBreak/>
                        - Kabelbakker (hård PVC)<LineBreak/>
                        - Trapezplader (hård PVC)<LineBreak/>
                        - Vinyl (blød PVC)<LineBreak/>
                        - Linoleum (blød PVC)
                        <LineBreak/><LineBreak/>
                        Afleveres typisk i:<LineBreak/>
                        - Container 16 Hård PVC<LineBreak/>
                        - Container 19 Blød PVC
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
