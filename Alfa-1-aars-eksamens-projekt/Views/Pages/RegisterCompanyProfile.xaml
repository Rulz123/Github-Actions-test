<Page x:Class="Alfa_1_aars_eksamens_projekt.Views.Pages.RegisterCompanyProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Opret Bruger - Environmental Friendly">
    <!--gamze-->
    <!--The DynamicResource is to target the entire grid that uses a general style defined in app xaml-->
    <Grid Background="White" Style="{DynamicResource RoundCornerMediumGreenGrid}">
        <Label Content="Opret bruger" FontSize="20" FontWeight="Bold" Margin="552,63,544,0" VerticalAlignment="Top"/>
        <Button Name="RegisterUser" Content="Opret bruger" Foreground="White" Background="#A7D930" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="585,484,0,0" VerticalAlignment="Top" Width="95" Height="30" Click="RegisterUser_Click"/>
        <TextBox Name="companyname" VerticalContentAlignment="Center" HorizontalAlignment="Left" BorderBrush="#A7D930" Background="#E9F6CB" BorderThickness="2" Height="30" Margin="517,151,0,0" VerticalAlignment="Top" Width="230" TextChanged="fieldValidator"/>
        <TextBox Name="username" VerticalContentAlignment="Center" HorizontalAlignment="Left" BorderBrush="#A7D930" Background="#E9F6CB" BorderThickness="2" Height="30" Margin="516,246,0,0" VerticalAlignment="Top" Width="230" TextChanged="fieldValidator"/>
        <PasswordBox Name="password" VerticalContentAlignment="Center" HorizontalAlignment="Left" BorderBrush="#A7D930" Background="#E9F6CB" BorderThickness="2" Height="30" Margin="516,340,0,0" VerticalAlignment="Top" Width="230" PasswordChanged="fieldValidatorPassword" RenderTransformOrigin="0.414,0.52"/>
        <RadioButton Name="consent" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="auto" HorizontalAlignment="Center" Content="Jeg accepterer at mine oplysninger gemmes" BorderBrush="#A7D930" BorderThickness="2" FontSize="14" Margin="464,412,484,0" VerticalAlignment="Top" Width="300" Height="30"/>
        <Label Content="Virksomhedsnavn" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="517,122,0,0" VerticalAlignment="Top" Width="126"/>
        <Label Content="Brugernavn" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="516,217,0,0" VerticalAlignment="Top" Width="126"/>
        <Label Content="Kodeord" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="517,312,0,0" VerticalAlignment="Top" Width="125"/>
        <Label x:Name="errorOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="517,440,0,0" VerticalAlignment="Top" Width="229"/>
        <Label x:Name="usernameOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="516,281,0,0" VerticalAlignment="Top" Width="230"/>
        <Label x:Name="passwordOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="517,381,0,0" VerticalAlignment="Top" Width="230"/>
        <Label x:Name="companynameOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="517,186,0,0" VerticalAlignment="Top" Width="230"/>
        <TextBlock x:Name="GoToLogin" HorizontalAlignment="Center" Margin="572,531,547,80" Width="161"><Run Text="   "/><Run Text=" "/><Run Text="   "/><Hyperlink NavigateUri="LoginPage.xaml"><Run Text="Gå tilbage til Login"/></Hyperlink></TextBlock>
    </Grid>
</Page>
