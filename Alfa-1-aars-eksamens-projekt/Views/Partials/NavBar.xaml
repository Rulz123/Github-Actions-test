<UserControl x:Class="Alfa_1_aars_eksamens_projekt.Views.Partials.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Partials"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="200">
    <!--Done by Keemon-->
    <StackPanel Name="Nav" Orientation="Vertical" Background="#e9f6cb">
        <Image Source="/Assets/Images/Elogo.png" Margin="10,10,10,0" />

        <StackPanel Name="frontPageNav" Style="{DynamicResource RoundCornerMediumGreen}">
        <Button Name="frontPage" Width="120" Height="30" Margin="0,50,0,0" Content="Forside" Click="frontPage_Click"/>
        </StackPanel>
        <StackPanel Name="companyProfileNav" Style="{DynamicResource RoundCornerMediumGreen}">
        <Button Name="companyProfile" Width="120" Height="30" Margin="0,20,0,0"  Content="Virksomhedsprofil" Click="companyProfile_Click"/>
        </StackPanel>
        <StackPanel Name="statisticsNav" Style="{DynamicResource RoundCornerMediumGreen}">
        <Button Name="statistics" Width="120" Height="30" Margin="0,20,0,0"  Content="Statistikker" Click="statistics_Click"/>
        </StackPanel>
        <StackPanel Name="wasteInformationNav" Style="{DynamicResource RoundCornerMediumGreen}">
        <Button Name="wasteInformation" Width="120" Height="30" Margin="0,20,0,0"  Content="Affaldsinformation" Click="wasteInformation_Click" />
        </StackPanel>
        <StackPanel Name="logoutNav" Style="{DynamicResource RoundCornerMediumGreen}">
        <Button Name="logout" Width="120" Height="30" Margin="0,20,0,0"  Content="Logud" Click="logout_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
