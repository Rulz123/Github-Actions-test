<Window x:Class="Alfa_1_aars_eksamens_projekt.Views.Popups.RegisterWasteElement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt.Views.Popups"
        mc:Ignorable="d"
        Title="Registrér Affald - Environmental Friendly" Height="800" Width="700">
    <!--gamze-->
    <!--Here we set the grid style we have made-->
    <Grid Style="{DynamicResource RoundCornerMediumGreenGrid}">
        <!--Here we set a label to tell the user to edite a waste element-->
        <Label Name="RedigérElement" Content="Registrér Affald" FontSize="25" HorizontalAlignment="Center" Margin="0,80,0,0" Width="190" />
        <!--We make a textbox to input amount of the waste element, and we bind it to the amount validator with the field validator-->
        <TextBox Name="PickAmount" HorizontalAlignment="Left" BorderBrush="#A7D930" Background="#E9F6CB" BorderThickness="2" Height="23" Margin="218,200,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="257" TextChanged="fieldValidator"/>
        <!--We set up a Combobox to pick a measurement unit, and bind it to the validator with selectionChangedValidator, that runs when the user select something-->
        <ComboBox Name="PickMU" HorizontalAlignment="Left" Margin="218,256,0,0" VerticalAlignment="Top" Width="257" SelectionChanged="selectionChangedValidator"/>
        <!--We setup a Combobox to pick a category, and we bind it to the validator with selectionChangedValidator, that runs when the user select something-->
        <ComboBox Name="PickCategory" HorizontalAlignment="Left" Margin="218,316,0,0" VerticalAlignment="Top" Width="257" SelectionChanged="selectionChangedValidator"/>
        <!--We setup a textbox to input a description of the waste element-->
        <TextBox Name="GiveDescription" HorizontalAlignment="Left" BorderBrush="#A7D930" Background="#E9F6CB" BorderThickness="2" Height="171" Margin="218,376,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="257"/>
        <!--We setup a combobox for the user to choose a responsible employee, and bind it to the validator with selectionChangedValidator, that runs when the user select something-->
        <ComboBox Name="PickRE" HorizontalAlignment="Center" Margin="0,580,0,0" VerticalAlignment="Top" Width="257" SelectionChanged="selectionChangedValidator"/>
        <!--We setup the button to create waste element, and input create waste element in the button to tell the user what the button do, we also bind the click event method in code behind-->
        <Button Name="RegisterWE"  Content="Opret affaldselement" Foreground="White" HorizontalAlignment="Left" Margin="263,628,0,0" VerticalAlignment="Top" Width="146" Height="27" Click="RegisterWE_Click"/>
        <!--We setup a label to tell the user to input the amount, right above the textbox-->
        <Label Content="Indtast mængde" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="215,167,0,0" VerticalAlignment="Top"/>
        <!--We setup a label to tell the user to choose a measurement unit from the combobox, and set it right above the combobox-->
        <Label Content="Vælg måleenhed" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="215,223,0,0" VerticalAlignment="Top"/>
        <!--We setup a label to tell the user to choose a category, and set it right above the combobox-->
        <Label Content="Vælg kategori" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="215,283,0,0" VerticalAlignment="Top"/>
        <!--We setup a label to tell the user to make a description of the waste element, and we set it right above the textbox-->
        <Label Content="Indtast affalds beskrivelse" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Margin="215,343,0,0" VerticalAlignment="Top"/>
        <!--We setup a label to tell the user to choose a responsible employee, and set it right above the combobox-->
        <Label Content="Vælg den ansvarlige medarbejder" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="215,552,267,0" VerticalAlignment="Top"/>
        <!--We setup a label for the error if the user fail to choose a category, and we set it right beside the combobox-->
        <Label x:Name="CategoryOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="474,316,0,0" VerticalAlignment="Top" Width="218" RenderTransformOrigin="0.502,0.524"/>
        <!--We setup a label for the error if the user fail to choose a measurement unit, and we set it right beside the combobox-->
        <Label x:Name="MUOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="480,256,0,0" VerticalAlignment="Top" Width="212"/>
        <!--We setup a label for the error if the user fail to choose a responsible employee, and we set it right beside the combobox-->
        <Label x:Name="REOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="474,580,0,0" VerticalAlignment="Top" Width="212"/>
        <!--We setup a label for the error if the user fail to input a amount, and we set it right beside the combobox-->
        <Label x:Name="amountOutput" Foreground="#D94130" Content="" HorizontalAlignment="Left" Margin="493,197,0,0" VerticalAlignment="Top" Width="199"/>

    </Grid>
</Window>
