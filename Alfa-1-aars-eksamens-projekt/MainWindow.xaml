<Window x:Class="Alfa_1_aars_eksamens_projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Alfa_1_aars_eksamens_projekt"
        mc:Ignorable="d"
        Title="Environmental Friendly" ResizeMode="NoResize" Height="720" Width="1280">
    <Grid>
        <!--The entire frame of the MainWindow is bound to PageContent, which allows us to swap between pages using INotifyPropertyChanged.-->
        <Frame Margin="0,0,0,0" Content="{Binding PageContent}" Name="PageContentFrame" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
